{
  "name": "education-management",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node -e \"process.env.WRANGLER_LOG_PATH='.wrangler/wrangler.log'; import('child_process').then(({spawn})=>spawn('vinext',['dev'],{stdio:'inherit',shell:true,env:process.env}).on('exit',code=>process.exit(code??0)))\"",
    "build": "node scripts/prepare-cloudflare-d1.mjs && node scripts/apply-cloudflare-migrations.mjs && node -e \"process.env.WRANGLER_LOG_PATH='.wrangler/wrangler.log'; import('child_process').then(({spawn})=>spawn('vinext',['build'],{stdio:'inherit',shell:true,env:process.env}).on('exit',code=>process.exit(code??0)))\"",
    "start": "node -e \"process.env.WRANGLER_LOG_PATH='.wrangler/wrangler.log'; import('child_process').then(({spawn})=>spawn('vinext',['start'],{stdio:'inherit',shell:true,env:process.env}).on('exit',code=>process.exit(code??0)))\"",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply education-management-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply education-management-db --remote",
    "cf:preview": "npm run build && wrangler dev --config dist/server/wrangler.json",
    "cf:deploy": "npm run build && wrangler deploy --config dist/server/wrangler.json",
    "deploy": "npm run cf:deploy"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.25.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
